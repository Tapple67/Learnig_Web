generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  grades Grade[]
}

model Grade {
  id        String   @id @default(cuid())
  year      Int
  term      Int
  userId    String
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects Subject[]

  @@unique([year, term, userId])
  @@index([userId])
}

model Subject {
  id        String   @id @default(cuid())
  name      String
  gradeId   String
  createdAt DateTime @default(now())
  isCurrent Boolean  @default(false)

  grade     Grade     @relation(fields:[gradeId], references: [id], onDelete: Cascade)
  materials Material[]

  @@index([gradeId])
}

model Material {
  id        String   @id @default(cuid())
  subjectId String
  week      Int
  title     String
  fileUrl   String
  createdAt DateTime @default(now())

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId])
  @@index([week])
}
model Note {
  id         String   @id @default(cuid())
  materialId String
  page       Int
  content    String   @default("")
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, page]) // 같은 자료의 같은 페이지 메모는 1개만
  @@index([materialId])
}


model Note {
  id         String   @id @default(cuid())
  materialId String
  page       Int
  content    String   @default("")
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, page])
  @@index([materialId])
}